# Somente servidor. Copie para .env.local; nunca coloque valores reais em assets/.
# PostgreSQL com TLS. Em produção, use a conexão pooled do Neon.
DATABASE_URL=
# Opcional: conexão administrativa separada, usada APENAS por db:migrate.
DATABASE_MIGRATION_URL=
SITE_URL=http://localhost:3000
# Caixa REAL e monitorada para solicitações de privacidade e respostas aos e-mails.
PRIVACY_EMAIL=
# Gere três segredos DIFERENTES, com pelo menos 32 caracteres aleatórios cada.
RATE_LIMIT_SECRET=
UNSUBSCRIBE_SECRET=
CRON_SECRET=
# O envio fica desativado até a configuração explícita. Cadastros ficam no banco.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Nunca ative antes de revisar a campanha. O cron só envia confirmações.
LAUNCH_ENABLED=false
# Somente desenvolvimento local com PostgreSQL sem TLS: nunca use em produção.
# DATABASE_ALLOW_INSECURE_LOCAL=true
