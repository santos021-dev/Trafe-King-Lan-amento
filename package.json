{
  "name": "trafe-king-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/admin.mjs migrate",
    "waitlist:inspect": "node --env-file-if-exists=.env.local scripts/admin.mjs inspect",
    "waitlist:remove": "node --env-file-if-exists=.env.local scripts/admin.mjs remove",
    "email:worker": "node --env-file-if-exists=.env.local scripts/admin.mjs worker",
    "email:review": "node --env-file-if-exists=.env.local scripts/admin.mjs review",
    "launch": "node --env-file-if-exists=.env.local scripts/admin.mjs launch"
  },
  "dependencies": {
    "@vercel/functions": "3.11.3",
    "pg": "8.23.1",
    "svix": "2.10.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "jsdom": "29.1.1"
  }
}
